---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet href="/assets/styles/fonts.css"?>
<?xml-stylesheet href="/assets/styles/feed.css"?>
<feed xmlns="http://www.w3.org/2005/Atom"  xmlns:very="{{ site.url }}">
	<generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">
		Jekyll
	</generator>
	<link href="{{ site.url }}{{ page.url }}" rel="self" type="application/atom+xml" />
	<link href="{{ site.url }}" rel="alternate" type="text/html" />
	<id>{{ site.url }}/sieveplate</id>
	<title>
		SievePlate
	</title>
	<updated>{{ site.posts.first.date | date_to_xmlschema }}</updated> <!-- publish date of latest post -->
	{% for post in site.posts %}
	<entry>
		<id>{{ site.url }}{{ post.id }}</id>
		<title>
			{{ post.title | xml_escape | strip_html }}
		</title>
		<link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape}}" />
		<published>{{ post.date | date_to_xmlschema }}</published>
		<updated>{{ post.date | date_to_xmlschema }}</updated>
		<content type="html">
			{{ post.content | xml_escape }}
		</content>
		{% assign author = site.data.authors | find: "id", post.author %}
		<author>
			<name>
				{{ author.fullname }}
			</name>
		</author>
		{% for tag in post.tags %}<category term="{{ tag }}" />
		{% endfor %}
		<!--
		<summary type="html">
			{{ post.excerpt | xml_escape }}
		</summary>
		-->
	</entry>
	{% endfor %}
	<very:veryimportant>Hey! If you're seeing this you likely just tried to open the SievePlate Atom feed in your browser. If you were trying to subscribe to the feed, just opening it in your browser won't work. Your feed reader should have a tool that allows you to add this to your reading list. Go to the feed reader's page and look for an "add feed" button. Then you can copy-paste the URL of this page in. Your feed reader might also have a tool to automatically detect and add feeds, which should work on this page or the main SievePlate page or any SievePlate post. You can use your browser's back button to go back to SievePlate. Thank you for your interest!</very:veryimportant>
</feed>
