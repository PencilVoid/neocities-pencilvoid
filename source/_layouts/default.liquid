<!doctype html>
<!--default layout -->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="Cache-Control" content="max-age=86400" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/assets/icons/favicon.ico" />
		<link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link href="/assets/styles/main.css" rel="stylesheet" type="text/css" media="all" />
		<title>{{ title }}</title>
		<meta name="theme-color" content="{{ css.dark.bg-checkerdark }}" />
		<style>
			{{ customcss }}

			{% include layout_style_default.css %}
		</style>
	</head>

	<body>
		<div class="body-grid-container">
			<div class="body-grid-left">
				<div class="sidenav-hamburger">
					<section class="dropdown-sidenav-hamburger" id="section-dropdown-sidebar-hamburger">
						<input type="checkbox" name="collapse" id="dropdown-sidebar-hamburger" />
						<label class="dropdown-label" for="dropdown-sidebar-hamburger"></label>
						<div class="dropdown-content">
							<span class="dropdown-hider">
								<nav>{% include sidebar.html hamburger=true %}</nav>
							</span>
						</div>
					</section>
				</div>
				<div class="sidenav">
					<nav>
						<a class="keyboard-nav-link" href="#main-content">Jump to main content</a>
						<a class="keyboard-nav-link" href="#colour-theme-choice">Jump to display controls</a>
						<hr id="keyboard-nav-separator" />
						{% include sidebar.html -%}
					</nav>
				</div>
			</div>
			<div class="body-grid-right">
				{% if decoration == "main" -%}
				<div class="spinner-container" aria-hidden="true">
					<img
						class="thing-supercore css-animated"
						src="/assets/images/decorations/thing_supercore.svg"
						alt=""
					/>
					<img class="thing-core css-animated" src="/assets/images/decorations/thing_core.svg" alt="" />
					<img class="thing-rays css-animated" src="/assets/images/decorations/thing_rays.svg" alt="" />
					<img class="thing-shell css-animated" src="/assets/images/decorations/thing_shell.svg" alt="" />
					<img class="thing-fringe css-animated" src="/assets/images/decorations/thing_fringe.svg" alt="" />
				</div>
				{% endif -%} {% if decoration == "eso" -%}
				<div class="eso-deco-bottomright" aria-hidden="true">
					<img
						class="eso-deco-br-grass-back css-animated"
						src="/assets/images/eso/deco_bottomright_grass_back.png"
						alt=""
					/>
					<img
						class="eso-deco-br-red-flower-1 css-animated"
						src="/assets/images/eso/deco_red_flower_1.png"
						alt=""
					/>
					<img
						class="eso-deco-br-red-flower-2 css-animated"
						src="/assets/images/eso/deco_red_flower_2.png"
						alt=""
					/>
					<img
						class="eso-deco-br-red-flower-3 css-animated"
						src="/assets/images/eso/deco_red_flower_3.png"
						alt=""
					/>
					<img
						class="eso-deco-br-grass-front css-animated"
						src="/assets/images/eso/deco_bottomright_grass_front.png"
						alt=""
					/>
				</div>
				<div class="eso-deco-topright css-animated" aria-hidden="true">
					<img
						class="eso-deco-tr-leaf-1 css-animated"
						src="/assets/images/eso/deco_topright_leaf_1.png"
						alt=""
					/>
					<img
						class="eso-deco-tr-leaf-2 css-animated"
						src="/assets/images/eso/deco_topright_leaf_2.png"
						alt=""
					/>
					<img
						class="eso-deco-tr-leaf-3 css-animated"
						src="/assets/images/eso/deco_topright_leaf_3.png"
						alt=""
					/>
				</div>
				{% endif -%}
				<div class="rightbox">{% include display_controls.html -%}</div>
			</div>
			<div class="body-grid-centre">
				<div class="content">
					<header>
						<h1>{{ header }}</h1>
					</header>
					<hr />
					<main id="main-content">{{ content }}</main>
					<hr />
					<footer>
						<span class="small-text">
							{% if last_modified_at -%}
							<p>Page last modified: {{ last_modified_at | date: "%d %B %Y %H:%M:%S UTC%z" }}</p>
							{%- endif %}
							<p>See <a href="/licensing">licensing information</a></p>
						</span>
					</footer>
				</div>
			</div>
		</div>
		{% include js_theme_switcher.html -%}
		<script src="/assets/scripts/settings_management_functions.js"></script>
		<script src="/assets/scripts/display_bg_checker.js"></script>
		<script src="/assets/scripts/dropdown_display_controls.js"></script>
		<script src="/assets/scripts/custom_main_content_width.js"></script>
	</body>
</html>
