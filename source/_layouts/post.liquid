---
css:
    dark:
        header-colour: "#18294F"
        bg-colour: "#0C4951"
        bg-checkerdark: "#105154"
        bg-checkerlight: "#19686D"
        bg-triangle: "#103B46"
        sidebar-colour: "#152F3C"
        text-colour: "#B2FFB2"
        a-colour: "#8BFF56"
        a-visited-colour: "#2CE06E"
        a-hover-colour: "#B2FFB2"
        a-active-colour: "#FFFFFF"
        hr-colour: "#3FF460"
        tone-colour: "#FFFFFF"
        header-small-colour: "#B2FFB2"
    light:
        header-colour: "#18294F"
        bg-colour: "#F3BDFA"
        bg-checkerdark: "#96F7D5"
        bg-checkerlight: "#B6F9DB"
        bg-triangle: "#A9E8D9"
        sidebar-colour: "#A4DDD2"
        text-colour: "#152F3C"
        a-colour: "#152F3C"
        a-visited-colour: "#0E2028"
        a-hover-colour: "#167397"
        a-active-colour: "#2195B2"
        hr-colour: "#188183"
        tone-colour: "#152F3C"
        header-small-colour: "#18294F"
---

<!doctype html>
<!--post layout -->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="Cache-Control" content="max-age=86400" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/assets/icons/favicon.ico" />
		<link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link href="/assets/styles/main.css" rel="stylesheet" type="text/css" media="all" />
		<title>{{ title }} | SievePlate</title>
		<link
			type="application/atom+xml"
			rel="alternate"
			href="{{ site.url }}/sieveplate/feed.xml"
			title="SievePlate"
		/>
		<meta name="theme-color" content="{{ css.dark.bg-checkerdark }}" />
		<style>
			{% include layout_style_post.css %}
		</style>
	</head>

	<body>
		<div class="body-grid-container">
			<div class="body-grid-left">
				<div class="sidenav-hamburger">
					<section class="dropdown-sidenav-hamburger" id="section-dropdown-sidebar-hamburger">
						<input type="checkbox" name="collapse" id="dropdown-sidebar-hamburger" />
						<label class="dropdown-label" for="dropdown-sidebar-hamburger"></label>
						<div class="dropdown-content">
							<span class="dropdown-hider">
								<nav>{% include sidebar.liquid, hamburger: true -%}</nav>
							</span>
						</div>
					</section>
				</div>
				<div class="sidenav">
					<nav>
						<a class="keyboard-nav-link" href="#main-content">Jump to main content</a>
						<a class="keyboard-nav-link" href="#colour-theme-choice">Jump to display controls</a>
						<hr id="keyboard-nav-separator" />
						{% include sidebar.liquid -%}
					</nav>
				</div>
			</div>
			<div class="body-grid-right">
				<div class="rightbox">{% include display_controls.liquid -%}</div>
			</div>
			<div class="body-grid-centre">
				<div class="content">
					<header>
						<h1>{{ title }}</h1>
					</header>
					<p style="font-style: italic">
						{{ page.date | date: "%d %B %Y (%Z)" }}
						{% assign page_author = collections.authors | find: "data.author_id", author %}
						{% if page_author -%}
						 - written by
						<a href="/authors/{{ page_author.data.author_id }}">{{ page_author.data.fullname }}</a>
						{% else -%}
						 - no author found
						{% endif -%}
						<br />
						Tags: {% for tag in tags %}{{tag}}{% unless forloop.last %}, {% endunless %}{% endfor %}
					</p>
					<hr />
					<main id="main-content">
						<article>{{ content }}</article>
					</main>
					<hr style="clear: both" />
					<footer>
						<div style="clear: both">
							{% if page.next -%}
							<p style="float: right; text-align: right">
								<a href="{{ page.next.url }}">Next post: {{ page.next.title }}</a><br />
								{{ page.next.date | date_to_string }}
							</p>
							{%- endif %} {% if page.previous -%}
							<p style="float: left; text-align: left">
								<a href="{{ page.previous.url }}">Previous post: {{ page.previous.title }}</a><br />
								{{ page.previous.date | date_to_string }}
							</p>
							{%- endif %}
						</div>
						<p style="text-align: center; clear: both">
							<a href="/sieveplate">See all posts</a>
						</p>
						<span class="small-text">
							{% if page.last_modified_at -%}
							<p>Page last modified: {{ page.last_modified_at | date: "%d %B %Y %H:%M:%S UTC%z" }}</p>
							{%- endif %}
							<p>See <a href="/licensing">licensing information</a></p>
						</span>
					</footer>
				</div>
			</div>
		</div>
		{% include js_theme_switcher_layout.liquid %}
		<script src="/assets/scripts/settings_management_functions.js"></script>
		<script src="/assets/scripts/display_bg_checker.js"></script>
		<script src="/assets/scripts/dropdown_display_controls.js"></script>
		<script src="/assets/scripts/custom_main_content_width.js"></script>
	</body>
</html>
